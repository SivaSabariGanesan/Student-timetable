# Copy this file to .env and fill in real values before starting the server.
# NEVER commit .env to version control.

# PostgreSQL connection string (Neon, Supabase, local, etc.)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT signing secret — must be a long, random string (min 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production if this is missing or set to the default.
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Token lifetime (default 7d — shorten to 1d or less for higher-security deployments)
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGIN=http://localhost:5173

PORT=3001
NODE_ENV=development
